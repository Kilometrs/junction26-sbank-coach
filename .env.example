# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional: any OpenAI-compatible provider. Several models = fallback order.
# LLM_BASE_URL=
# LLM_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Folder containing the S-Bank CSVs (cloned from hackjunction/Junction-2026-S-pankki)
SBANK_DATA_DIR=../Junction-2026-S-pankki
# OpenRouter example:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=
# Demo limits (optional, these are the defaults)
# CHAT_PER_MINUTE=10
# CHAT_DAILY_LIMIT=1500
# CHAT_MAX_MESSAGE=500
# LLM_MAX_TOKENS=1500
# Proxies in front of the server (0 = visitors connect directly, 1 = Cloud Run)
# CHAT_PROXY_HOPS=0
